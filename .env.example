# Copy to .env.local for local development. Never commit a filled-in copy.
# In production these are set in the Vercel project settings.

# Supabase: project API URL and the server-only service-role key.
# NEXT_PUBLIC_SUPABASE_URL is exposed to the browser by design; the
# service-role key must never be.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the analyser and ideation features.
ANTHROPIC_API_KEY=

# LTI 1.3. LTI_PRIVATE_KEY is the RSA private signing key; the JWKS endpoint
# derives and publishes only the matching public key.
LTI_PRIVATE_KEY=
LTI_PLATFORM_JWKS_URL=
LTI_PLATFORM_ISSUER=
LTI_CLIENT_ID=

# Public origin of the deployed app, no trailing slash.
NEXT_PUBLIC_APP_URL=

# Per-user daily usage cap. Defaults to 20 if unset.
DAILY_LIMIT=
